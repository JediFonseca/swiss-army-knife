#!/bin/bash

set -u

blue='\033[0;36m'
green='\033[0;32m'
yellow='\033[1;33m'
red='\033[0;31m'
nocolor='\033[0m'

remote="jedifonseca@100.106.24.12"
remote_ip="100.106.24.12"

documentos1="$HOME/Documentos/Dados/Documentos/"
imagens1="$HOME/Documentos/Dados/Imagens/"
musicas1="$HOME/Documentos/Dados/Músicas/"
midias1="$HOME/Documentos/Dados/Mídias/"
jogos1="$HOME/Documentos/Dados/Jogos/"
videos1="$HOME/Documentos/Dados/Vídeos/"
nextcloud1="$HOME/Documentos/Dados/Nextcloud/"

documentos2="/mnt/Backup/Documentos/"
imagens2="/mnt/Backup/Imagens/"
musicas2="/mnt/Backup/Músicas/"
midias2="/mnt/Backup/Mídias/"
jogos2="/mnt/Backup/Jogos/"
videos2="/mnt/Backup/Vídeos/"
nextcloud2="/mnt/Backup/Nextcloud/"

# ------------------------------------------------------------------------------------------------------------------------

safety_checks () {

clear

echo -e "${blue}Testando conexão com o Serverus...${nocolor}"

if ping -c3 -W3 "$remote_ip" > /dev/null; then
    echo -e "${green}\nConexão OK!${nocolor}"
else
    echo -e "${red}\nServidor não responde!${nocolor}"
    exit 3
fi

mountpoint -q /mnt/Backup || { echo -e "${red}Backup não montado!${nocolor}"; exit 1; }

}

# ------------------------------------------------------------------------------------------------------------------------

permissions () {

echo -e "${blue}\nExecutando o chmod. Inserindo a senha automaticamente, aguarde...${nocolor}"
ssh $remote "sudo chmod -R 777 $HOME/Documentos"

}

# ------------------------------------------------------------------------------------------------------------------------

sinc_local () {

echo -e "${blue}\n\nSincronizando os Documentos...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$documentos1" "$documentos2"

echo -e "${blue}\nSincronizando as Imagens...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$imagens1" "$imagens2"

echo -e "${blue}\nSincronizando as Músicas...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$musicas1" "$musicas2"

echo -e "${blue}\nSincronizando as Mídias...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$midias1" "$midias2"

echo -e "${blue}\nSincronizando os Jogos...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$jogos1" "$jogos2"

echo -e "${blue}\nSincronizando os Vídeos...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$videos1" "$videos2"

echo -e "${blue}\nSincronizando os arquivos do Nextcloud...${nocolor}"
rsync -ah --partial --info=progress2 --stats --delete "$remote:$nextcloud1" "$nextcloud2"

}

# ------------------------------------------------------------------------------------------------------------------------

safety_checks
permissions
sinc_local

echo -e -n "${yellow}\nPressione ENTER para voltar ao menu ou CTRL+C para cancelar.${nocolor}"
read -r
